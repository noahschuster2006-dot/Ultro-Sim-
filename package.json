{
  "name": "lifesim-ultra",
  "private": true,
  "version": "0.1.0",
  "description": "LifeSim Ultra — a deep, generational life simulation engine and web game.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "npm run build && node scripts/build-single.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "simulate": "tsx scripts/simulate.ts",
    "content": "tsx scripts/content-report.ts"
  },
  "dependencies": {
    "lucide-react": "1.47.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "4.7.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  }
}
